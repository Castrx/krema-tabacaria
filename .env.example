# Chave do Google Maps Embed API, usada em components/home/Location.tsx.
# Sem essa variável, a seção de localização exibe um aviso no lugar do mapa.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Supabase (Fase 1 do backend — provisionamento; catálogo ainda não conectado).
# URL do projeto e chave anônima (pública, segura para o client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — chave de service role. Ignora Row Level Security por completo.
# Nunca usar em código client, nunca commitar. Somente em rotas/servidor.
SUPABASE_SERVICE_ROLE_KEY=
