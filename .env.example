# Chave do Google Maps Embed API, usada em components/home/Location.tsx.
# Sem essa variável, a seção de localização exibe um aviso no lugar do mapa.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Supabase (Fase 1 do backend — provisionamento; catálogo ainda não conectado).
# URL do projeto e chave anônima (pública, segura para o client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — chave de service role. Ignora Row Level Security por completo.
# Nunca usar em código client, nunca commitar. Somente em rotas/servidor.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — access token do Mercado Pago (lib/payments/mercadopago.ts).
# Etapa atual: SOMENTE sandbox — use o valor de "Dados da integração →
# Testes → Credenciais de teste" no painel do Checkout Pro (pode vir com
# prefixo "TEST-" ou "APP_USR-" — o Mercado Pago usa os dois formatos
# para credencial de teste; confirme a origem no painel, não pelo
# prefixo). Nunca uma credencial da aba de produção. Nunca usar em código
# client, nunca commitar. Somente em app/api/checkout/payment/route.ts
# (server-side).
MERCADOPAGO_ACCESS_TOKEN=

# SECRET — assinatura secreta do webhook do Mercado Pago
# (app/api/webhooks/mercadopago/route.ts). Diferente do access token
# acima — gerada em "Dados da integração → Webhooks" no painel, ao
# configurar a URL de notificação. Usada só para validar x-signature;
# nunca usar em código client, nunca commitar.
MERCADOPAGO_WEBHOOK_SECRET=

# SECRET — access token do Melhor Envio (lib/shipping/melhor-envio.ts).
# Etapa atual: SOMENTE sandbox (sandbox.melhorenvio.com.br) — gere numa
# conta de teste do Melhor Envio, nunca uma credencial de produção. Nunca
# usar em código client, nunca commitar.
MELHORENVIO_ACCESS_TOKEN=

# Header User-Agent exigido pela API do Melhor Envio — formato "Nome da
# aplicação (email de contato)". Não é secreto, mas precisa de um e-mail
# de contato real da Krema (ainda não definido — ver relatório desta etapa).
MELHORENVIO_USER_AGENT=
